local function InstallExecutorConsoleBridge(ChannelId)
    local function ResolveMoonHook()
        if getrenv then
            local Ok, Renenv = pcall(getrenv);

            if Ok and type(Renenv.shared) == 'table' then
                if type(Renenv.shared.moonhook) == 'table' then
                    return Renenv.shared.moonhook;
                end;

                if type(Renenv.shared.moonhook_probe) == 'function' then
                    return { probePF = Renenv.shared.moonhook_probe; diagnose = Renenv.shared.moonhook_diagnose };
                end;
            end;
        end;

        if getgenv then
            local Ok, Env = pcall(getgenv);

            if Ok and type(Env.moonhook) == 'table' then
                return Env.moonhook;
            end;
        end;

        if type(shared) == 'table' and type(shared.moonhook) == 'table' then
            return shared.moonhook;
        end;

        if type(_G.moonhook) == 'table' then
            return _G.moonhook;
        end;

        return nil;
    end;

    local function RequestViaChannel(RequestType, Timeout)
        if not ChannelId or not get_comm_channel then
            return nil, 'channel unavailable';
        end;

        local Result = nil;
        local Done = false;
        local Connection;

        pcall(function()
            Connection = get_comm_channel(ChannelId).Event:Connect(function(Message)
                if type(Message) == 'table' and Message.type == RequestType .. 'Result' then
                    Result = Message.result;
                    Done = true;
                end;
            end);

            get_comm_channel(ChannelId):Fire({ type = RequestType .. 'Request' });
        end);

        local Started = tick();

        while not Done and (tick() - Started) < (Timeout or 5) do
            task.wait(0.05);
        end;

        if Connection then
            pcall(function()
                Connection:Disconnect();
            end);
        end;

        if Done then
            return Result;
        end;

        return nil, 'timeout waiting for PF client';
    end;

    local function MoonHookProbe(...)
        if getrenv then
            local Ok, Renenv = pcall(getrenv);
            local SharedProbe = Ok and Renenv.shared and Renenv.shared.moonhook_probe;

            if type(SharedProbe) == 'function' and SharedProbe ~= MoonHookProbe then
                return SharedProbe(...);
            end;
        end;

        local Hook = ResolveMoonHook();

        if Hook and type(Hook.probePF) == 'function' then
            return Hook.probePF(...);
        end;

        local ChannelResult = RequestViaChannel('probe', 5);

        if type(ChannelResult) == 'table' then
            if ChannelResult.error then
                error('[MoonHook] probe failed in PF client: ' .. tostring(ChannelResult.error));
            end;

            return ChannelResult;
        end;

        error('[MoonHook] probe unavailable — use Settings → Skeleton debug, or wait for "MoonHook ready"');
    end;

    local function MoonHookDiagnose(...)
        if getrenv then
            local Ok, Renenv = pcall(getrenv);
            local SharedDiagnose = Ok and Renenv.shared and Renenv.shared.moonhook_diagnose;

            if type(SharedDiagnose) == 'function' and SharedDiagnose ~= MoonHookDiagnose then
                return SharedDiagnose(...);
            end;
        end;

        local Hook = ResolveMoonHook();

        if Hook and type(Hook.diagnose) == 'function' then
            return Hook.diagnose(...);
        end;

        local ChannelResult = RequestViaChannel('diagnose', 5);

        if type(ChannelResult) == 'table' then
            if ChannelResult.error then
                error('[MoonHook] diagnose failed in PF client: ' .. tostring(ChannelResult.error));
            end;

            return ChannelResult;
        end;

        error('[MoonHook] diagnose unavailable — use Settings → Run diagnostics, or wait for "MoonHook ready"');
    end;

    local Targets = { _G };

    if getgenv then
        pcall(function()
            Targets[#Targets + 1] = getgenv();
        end);
    end;

    for _, Target in Targets do
        if type(Target) == 'table' then
            Target.moonhook_probe = MoonHookProbe;
            Target.moonhook_diagnose = MoonHookDiagnose;
        end;
    end;
end;

InstallExecutorConsoleBridge(MoonHookChannelId);

if HasPFRequire() then
    print('[MoonHook] running in PF client context');
    RunPayload(Source);
    return;
end;

if getsenv and getrunningscripts then
    for _, Script in getrunningscripts() do
        local Ok, Environment = pcall(getsenv, Script);
        if Ok and type(Environment) == 'table' and Environment.shared and type(Environment.shared.require) == 'function' then
            print('[MoonHook] found PF require via getsenv, running directly');
            RunPayload(Source);
            return;
        end;
    end;
end;

BootstrapProgress('Executor VM detected — injecting into PF client context', 2, 6);

local Dispatched, Method = DispatchToPFContext(Source);
if Dispatched then
    print('[MoonHook] dispatched via ' .. tostring(Method));
    return;
end;

warn('[MoonHook] failed to enter PF client context (executor: ' .. tostring((type(identifyexecutor) == 'function' and identifyexecutor()) or 'unknown') .. ')');

BootstrapProgress('Falling back to executor VM execution (PF injection failed)', 6, 6);

if RunPayload(Source) then
    BootstrapProgress('Payload ran in executor VM', 6, 6);
    return;
end;

if queue_on_teleport and setfflag then
    warn('[MoonHook] trying rejoin bootstrap as last resort');
    setfflag('DebugRunParallelLuaOnMainThread', 'True');

    queue_on_teleport([=[
        repeat task.wait() until game:IsLoaded()
        task.wait(1);
    ]=] .. Source);

    game:GetService('TeleportService'):TeleportToPlaceInstance(game.PlaceId, game.JobId);
    return;
end;

warn('[MoonHook] load failed: use an updated internal executor (see README) — Potassium, Volt, Wave, SirHurt, Real, Isaeva, Madium. Status: https://whatexpsare.online/');
