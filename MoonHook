local function GetPFShared()
    return getrenv().shared or shared;
end;

local function HasPFRequire()
    local PFShared = GetPFShared();
    return PFShared and type(PFShared.require) == 'function';
end;

local function RunPayload(Source)
    local Function, CompileError = loadstring(Source);
    if not Function then
        warn('[MoonHook] compile error: ' .. tostring(CompileError));
        return false;
    end;

    local Ok, RuntimeError = pcall(Function);
    if not Ok then
        warn('[MoonHook] runtime error: ' .. tostring(RuntimeError));
        return false;
    end;

    return true;
end;

local function BootstrapProgress(Message, Step, Total)
    Step = Step or 0;
    Total = Total or 0;

    local Prefix = '[MoonHook]';
    if Step > 0 and Total > 0 then
        print(string.format('%s (%d/%d) %s', Prefix, Step, Total, Message));
    else
        print(Prefix .. ' ' .. Message);
    end;
end;

local function GetLongStringDelimiterLevel(Text)
    local Level = 0;
    while Text:find(']' .. string.rep('=', Level) .. ']', 1, true) do
        Level = Level + 1;
    end;
    return Level;
end;

local function WrapSource(Source, ChannelId)
    local Level = GetLongStringDelimiterLevel(Source);
    local Open = '[' .. string.rep('=', Level) .. '[';
    local Close = ']' .. string.rep('=', Level) .. ']';

    local ChannelSetup = '';
    local LoadedPing = '';

    if ChannelId then
        ChannelSetup = '    shared.__MOONHOOK_CHANNEL = ' .. tostring(ChannelId) .. ';';
        LoadedPing = '\n    if get_comm_channel then pcall(function() get_comm_channel(' .. tostring(ChannelId) .. '):Fire("loaded") end) end';
    end;

    return table.concat({
        'if getrenv().shared and type(getrenv().shared.require) == "function" and not shared.__MOONHOOK_BOOTED then';
        '    shared.__MOONHOOK_BOOTED = true;';
        ChannelSetup;
        '    local __fn, __err = loadstring(' .. Open .. Source .. Close .. ')';
        '    if not __fn then';
        '        warn("[MoonHook] compile error: " .. tostring(__err));';
        '    else';
        '        local __ok, __runtime = pcall(__fn);';
        '        if not __ok then';
        '            warn("[MoonHook] runtime error: " .. tostring(__runtime));';
        '        else';
        LoadedPing;
        '        end;';
        '    end;';
        'end';
    }, '\n');
end;

local function WaitForPFInstances(Timeout)
    Timeout = Timeout or 120;
    local Started = tick();
    local LastProgress = 0;

    BootstrapProgress('Waiting for Phantom Forces to finish loading...', 1, 6);

    while (tick() - Started) < Timeout do
        local ReplicatedStorage = game:GetService('ReplicatedStorage');
        local ReplicatedFirst = game:GetService('ReplicatedFirst');
        local HasRemote = ReplicatedStorage:FindFirstChild('RemoteEvent');
        local HasClientModules = ReplicatedFirst:FindFirstChild('ClientModules', true);
        local Elapsed = tick() - Started;

        if Elapsed - LastProgress >= 2 then
            LastProgress = Elapsed;
            BootstrapProgress(
                string.format('Still waiting for PF client (%.0fs) — RemoteEvent=%s ClientModules=%s',
                    Elapsed,
                    tostring(HasRemote ~= nil),
                    tostring(HasClientModules ~= nil)
                ),
                1,
                6
            );
        end;

        if HasRemote and HasClientModules then
            BootstrapProgress('PF client instances ready', 2, 6);
            return true;
        end;

        task.wait(0.25);
    end;

    warn('[MoonHook] timed out waiting for PF instances (RemoteEvent / ClientModules)');
    return false;
end;

local function CollectReplicatedFirstLocalScripts()
    local Scripts = {};
    local Seen = {};
    local ReplicatedFirst = game:GetService('ReplicatedFirst');

    local function AddScript(Script)
        if Script and Script:IsA('LocalScript') and not Seen[Script] then
            Seen[Script] = true;
            Scripts[#Scripts + 1] = Script;
        end;
    end;

    for _, Child in ReplicatedFirst:GetChildren() do
        AddScript(Child);
    end;

    for _, Descendant in ReplicatedFirst:GetDescendants() do
        AddScript(Descendant);
    end;

    return Scripts;
end;

local function ExecuteOnLuaState(State, Source, Label)
    if not State or type(State.Execute) ~= 'function' then
        return false;
    end;

    local Ok, Error = pcall(State.Execute, State, Source);
    if not Ok then
        warn('[MoonHook] state execute failed (' .. Label .. '): ' .. tostring(Error));
        return false;
    end;

    return true;
end;

